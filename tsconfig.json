{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "#core/*": ["./server/core/*"],
      "#server/*": ["./server/*"],
      "#cli/*": ["./cli/*"]
    }
  },
  "include": ["server/**/*", "cli/**/*"],
  "exclude": ["node_modules", "dist", "app"]
}
