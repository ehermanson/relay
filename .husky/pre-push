export PATH="/usr/local/bin:$HOME/.cargo/bin:$PATH"

# Pre-push gate: mirror CI (build → typecheck → lint → task checks → test), but skip the heavy
# checks when the push contains only docs / non-code changes.
#
# Git feeds ref updates on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# We collect every file changed across the pushed range and decide whether any
# of them can affect build/typecheck/lint/test output.

ZERO="0000000000000000000000000000000000000000"
remote="$1"
changed=""

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion — nothing to check.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: compare against the merge-base with the remote's
    # default branch so we don't re-check the entire history.
    base="$(git merge-base "$local_sha" "refs/remotes/$remote/HEAD" 2>/dev/null)"
    [ -z "$base" ] && base="$(git merge-base "$local_sha" "refs/remotes/$remote/main" 2>/dev/null)"
    if [ -n "$base" ]; then
      range="$base..$local_sha"
    else
      range="$local_sha"   # fall back to just the tip commit
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  files="$(git diff --name-only "$range" 2>/dev/null)"
  changed="$changed
$files"
done

# Nothing to push (e.g. up to date) — allow.
changed="$(printf '%s\n' "$changed" | sed '/^$/d' | sort -u)"
if [ -z "$changed" ]; then
  exit 0
fi

# Task Markdown is executable workflow data even on a docs-only push.
tasks_changed=0
while IFS= read -r f; do
  case "$f" in
    .relay/tasks/*|.relay/task-discussion/*|.relay/tasks.json)
      tasks_changed=1 ;;
  esac
done <<EOF
$changed
EOF
if [ "$tasks_changed" -eq 1 ]; then
  pnpm tasks:check || exit $?
fi

# A file is "ignorable" if it cannot change build/typecheck/lint/test results.
# Everything that is NOT ignorable forces the full check. This is intentionally
# conservative: unknown file types run the checks.
code_changed=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.md|LICENSE|LICENSE.*|*.txt|.gitignore|.gitattributes|.editorconfig|docs/*|.github/ISSUE_TEMPLATE/*|.vscode/*)
      : ;;  # ignorable
    *)
      code_changed=1
      break ;;
  esac
done <<EOF
$changed
EOF

if [ "$code_changed" -eq 0 ]; then
  echo "pre-push: only docs/non-code files changed — skipping build/typecheck/lint/test."
  exit 0
fi

echo "pre-push: code changed — running CI checks (build → typecheck → lint → task checks → test)…"
pnpm ci-check
