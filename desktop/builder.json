{
  "appId": "com.relay.desktop",
  "productName": "Relay",
  "directories": {
    "app": ".desktop-stage",
    "output": "desktop-release"
  },
  "files": [
    "desktop/**/*",
    "dist/**/*",
    "app/dist/**/*",
    "app/public/icon-192.png",
    "app/public/icon-512.png",
    "package.json",
    "!desktop/*.test.mjs",
    "!desktop/build.mjs",
    "!desktop/benchmark.mjs",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map"
  ],
  "asarUnpack": [
    "**/*.node",
    "**/node-pty/**",
    "**/@anthropic-ai/claude-agent-sdk/**",
    "**/@anthropic-ai/claude-agent-sdk-*/**"
  ],
  "npmRebuild": true,
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"],
    "hardenedRuntime": true,
    "icon": "desktop/icon.icns",
    "notarize": true
  },
  "win": {
    "target": ["nsis"],
    "icon": "app/public/icon-512.png"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Development",
    "icon": "app/public/icon-512.png"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "ehermanson",
      "repo": "relay",
      "releaseType": "draft"
    }
  ],
  "protocols": [
    {
      "name": "Relay Chat",
      "schemes": ["relay"]
    }
  ],
  "artifactName": "Relay-${version}-${os}-${arch}.${ext}"
}
